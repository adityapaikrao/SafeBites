# Server
PORT=8080
ENV=development

# PostgreSQL (local Docker) - Use strong passwords in production!
POSTGRES_USER=safebites
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=safebites
DATABASE_URL=postgres://safebites:your-secure-password-here@localhost:5432/safebites?sslmode=disable
MIGRATIONS_PATH=migrations

# Google AI (required)
GOOGLE_API_KEY=your-gemini-api-key-here

# Auth0 (leave blank to run in dev-mode bypass)
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
